# Copy to .env and adjust. Without DATABASE_URL the app uses local SQLite.

# Neon pooled connection string (hostname contains "-pooler") — same value the
# Vercel deployment uses, so local dev and production share one database.
# DATABASE_URL=postgres://user:pass@host-pooler.neon.tech/db?sslmode=require

# Django secret key — a random string; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# SECRET_KEY=change-me

# Anthropic API key — leave empty to use the built-in offline question
# generator (the human-in-the-loop review flow still works).
# ANTHROPIC_API_KEY=sk-ant-...

# Production flag — set to 0 on Vercel.
# DEBUG=0

# Hosts the app accepts — defaults already include localhost and *.vercel.app.
# ALLOWED_HOSTS=scholaris.vercel.app

# Minimum rating responses before an aggregate is revealed (privacy rule).
# RATING_MIN_RESPONSES=3
