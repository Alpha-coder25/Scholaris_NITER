{
  "buildCommand": "python manage.py collectstatic --noinput",
  "outputDirectory": ".",
  "framework": null,
  "installCommand": "pip install --break-system-packages -r requirements.txt",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "scholaris.settings",
    "PYTHONPATH": "."
  }
}
